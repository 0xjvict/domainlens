  },
  "homepage": "https://github.com/jvmelo/domainlens#readme",
  "bugs": {
    "url": "https://github.com/jvmelo/domainlens/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.10.0",
    "commander": "^12.1.0",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
