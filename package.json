{
  "name": "domainlens",
  "version": "0.1.0",
  "description": "AI-native domain knowledge layer for code agents",
  "type": "module",
  "bin": {
    "domainlens": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc",
